# Connection string do PostgreSQL (no Supabase: Project Settings > Database, usuário postgres).
DATABASE_URL=postgresql://postgres:SENHA@db.SEU-PROJETO.supabase.co:5432/postgres

# Validação do token do Supabase Auth: use o "JWT secret" (HS256) OU só a URL do projeto
# (chaves públicas de assinatura). Com as duas, vale o segredo.
SUPABASE_JWT_SECRET=
SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Só para o script do administrador da plataforma (python -m app.cli). Nunca no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Origens do frontend autorizadas (JSON).
CORS_ORIGINS=["http://localhost:5173"]

# Cifra as chaves de API das organizações. Gerar uma vez e guardar (sem ela as chaves salvas
# não podem ser lidas):
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CHAVE_CIFRAGEM=

# Agente de prospecção: "falso" (empresas fictícias) ou "pacote.modulo:Classe".
AGENTE_PROSPECCAO=falso
